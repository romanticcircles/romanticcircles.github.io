<?php
/**
 * Some comments here.
 */

/**
 * Implements hook_apachesolr_index_document_build().
 * Adding in the praxis icon field
 */
function rc_search_results_apachesolr_index_document_build($document, $node, $namespace) {
  if (isset($node->field_prax_icon[LANGUAGE_NONE]['0']['uri'])) {
    $document->addField('ss_field_prax_icon', $node->field_prax_icon[LANGUAGE_NONE]['0']['uri']);
  }
}

/**
 * Implements hook_apachesolr_query_alter().
 * Make prax icon available to the theme.
 */
function mymodule_apachesolr_query_alter($query) {
  $query->addParam('fl', 'ss_field_prax_icon');
}
