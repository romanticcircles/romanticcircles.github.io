{
    "name": "romanticcircles/rc-website",
    "description": "Drupal website at romantic-circles.org",
    "type": "project",
    "license": "GPL-2.0-or-later",
    "homepage": "https://www.romantic-circles.org",
    "readme": "README.md",
    "repositories": [
        {
            "type": "composer",
            "url": "https://packages.drupal.org/8"
        },        
        {
            "type": "composer",
            "url": "https://asset-packagist.org"
        }
    ],    
    "authors": [
        {
            "name": "Jessica Tebo",
            "email": "jetebo8@gmail.com",
            "role": "Technical Editor"
        },
        {
            "name": "Stephen Kasica",
            "email": "kasica@alumni.ubc.ca",
            "role": "Developer"
        } 
    ],
    "support": {
        "docs": "https://romanticcircles.github.io"
    },
    "require": {
        "composer/installers": "^2.2",
        "cweagans/composer-patches": "^1.7",
        "drupal/asset_injector": "^2.17",
        "drupal/auto_alter": "^2.0@alpha",
        "drupal/bootstrap": "^3.28",
        "drupal/bootstrap5": "^3.0",
        "drupal/colorbox": "^2.0",
        "drupal/colorbox_load": "^1.3",
        "drupal/core-composer-scaffold": "^10",
        "drupal/core-project-message": "^10",
        "drupal/core-recommended": "^10",
        "drupal/ctools": "^4.0",
        "drupal/dxpr_theme": "^1.3",
        "drupal/feeds": "^3.0@beta",
        "drupal/feeds_ex": "^1.0@beta",
        "drupal/feeds_tamper": "^2.0@beta",
        "drupal/geofield": "^1.53",
        "drupal/google_analytics": "^4.0",
        "drupal/layout_builder_styles": "^2.0",
        "drupal/leaflet": "^10.0",
        "drupal/leaflet_layers": "^1.1",
        "drupal/libraries": "^4.0",
        "drupal/metatag": "^2.0",
        "drupal/ng_lightbox": "^2.0",
        "drupal/pathauto": "^1.11",
        "drupal/smart_date": "^4.0",
        "drupal/stage_file_proxy": "^2.0",
        "drupal/tamper": "^1.0@alpha",
        "drupal/token": "^1.12",
        "drupal/views_bootstrap": "^5.4",
        "drupal/views_contextual_filters_or": "^1.4",
        "drupal/views_slideshow": "^5.0",
        "drush/drush": "^12"
    },
    "conflict": {
        "drupal/drupal": "*"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "composer/installers": true,
            "drupal/core-composer-scaffold": true,
            "drupal/core-project-message": true,
            "cweagans/composer-patches": true,
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "phpstan/extension-installer": true
        },
        "vendor-dir": "vendor",
        "preferred-install": "dist"
    },
    "extra": {
        "drupal-scaffold": {
            "locations": {
                "web-root": "docroot/"
            }
        },
        "installer-paths": {
            "docroot/core": [
                "type:drupal-core"
            ],
            "docroot/libraries/{$name}": [
                "type:drupal-library"
            ],
            "docroot/modules/contrib/{$name}": [
                "type:drupal-module"
            ],
            "docroot/profiles/contrib/{$name}": [
                "type:drupal-profile"
            ],
            "docroot/themes/contrib/{$name}": [
                "type:drupal-theme"
            ],
            "drush/Commands/contrib/{$name}": [
                "type:drupal-drush"
            ],
            "docroot/modules/custom/{$name}": [
                "type:drupal-custom-module"
            ],
            "docroot/profiles/custom/{$name}": [
                "type:drupal-custom-profile"
            ],
            "docroot/themes/custom/{$name}": [
                "type:drupal-custom-theme"
            ]
        },
        "drupal-core-project-message": {
            "include-keys": [
                "homepage",
                "support"
            ],
            "post-create-project-cmd-message": [
                "<bg=blue;fg=white>                                                         </>",
                "<bg=blue;fg=white>  Congratulations, you’ve installed the Drupal codebase  </>",
                "<bg=blue;fg=white>  from the drupal/recommended-project template!          </>",
                "<bg=blue;fg=white>                                                         </>",
                "",
                "<bg=yellow;fg=black>Next steps</>:",
                "  * Install the site: https://www.drupal.org/docs/8/install",
                "  * Read the user guide: https://www.drupal.org/docs/user_guide/en/index.html",
                "  * Get support: https://www.drupal.org/support",
                "  * Get involved with the Drupal community:",
                "      https://www.drupal.org/getting-involved",
                "  * Remove the plugin that prints this message:",
                "      composer remove drupal/core-project-message"
            ]
        }
    }
}
